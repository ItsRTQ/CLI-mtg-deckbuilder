{
  "land_count_formula": {
    "description": "Build nonlands first, then calculate final land count and cut/fill nonlands to reach 99 main deck cards.",
    "base_lands": 32,
    "color_adjustment": {
      "per_commander_color": 1,
      "max_color_bonus": 3
    },
    "curve_adjustment": {
      "average_mana_value_0_to_2_6": 0,
      "average_mana_value_2_7_to_3_3": 1,
      "average_mana_value_3_4_plus": 2
    },
    "landfall_landsmatter": {
      "min": 38,
      "ideal": 40,
      "max": 42
    },
    "absolute_safety": {
      "min": 30,
      "max": 42
    }
  },
  "power_levels": {
    "casual": {
      "description": "Precon/precon-level. No infinite combos. No tutors by default. Tapped lands are acceptable if budget or mana fixing needs them.",
      "infinite_combos": "none",
      "tutors": {
        "min": 0,
        "ideal": 0,
        "max": 0
      },
      "synergy_expectation": "basic_to_medium",
      "fast_mana": "avoid_except_sol_ring_if_allowed",
      "tapped_lands": "allowed_if_needed"
    },
    "optimized_casual": {
      "description": "Optimized precon/focused casual. 1-2 tutors if they make sense. No infinite combos. Avoid tapped lands unless theme, commander, or budget makes them reasonable.",
      "infinite_combos": "none",
      "tutors": {
        "min": 0,
        "ideal": 1,
        "max": 2
      },
      "synergy_expectation": "medium_to_high",
      "fast_mana": "limited",
      "tapped_lands": "avoid_unless_justified"
    },
    "high_power": {
      "description": "High synergy. 1-2 incidental infinite combos allowed, but the deck should not be built entirely around forcing them unless requested.",
      "infinite_combos": "incidental_allowed_1_to_2",
      "tutors": {
        "min": 1,
        "ideal": 3,
        "max": 6
      },
      "synergy_expectation": "high",
      "fast_mana": "allowed_if_budget_allows",
      "tapped_lands": "avoid_unless_justified"
    },
    "cedh": {
      "description": "No budget by default. Perfect synergy, tutors, compact combos, optimized interaction, and fast mana are expected.",
      "infinite_combos": "unlimited",
      "tutors": {
        "min": 4,
        "ideal": 8,
        "max": 14
      },
      "synergy_expectation": "highest",
      "fast_mana": "expected",
      "tapped_lands": "avoid_except_powerful_utility"
    }
  },
  "budget_rules": {
    "ask_if_missing": true,
    "default_if_unanswered": "no_budget",
    "preset_options": [
      100,
      150,
      200,
      "no_budget",
      "custom"
    ],
    "custom_budget_too_low": {
      "behavior": "continue_deckbuilding",
      "fallback_range": [
        50,
        100
      ],
      "basic_lands_count_as": 0,
      "note": "Deck build is more important than perfectly meeting a very low budget. Get as close as possible and explain budget pressure."
    },
    "upgrades": {
      "offer_after_deck": true,
      "rank_by": [
        "importance",
        "power_increase",
        "price_impact"
      ]
    }
  },
